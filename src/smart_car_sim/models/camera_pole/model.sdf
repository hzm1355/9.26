<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="camera_pole">
    <!-- 立杆 + 摄像头，用于测速/路口监控 -->

    <link name="pole">
      <inertial>
        <mass>5.0</mass>
        <pose>0 0 1.5 0 0 0</pose>
        <inertia>
          <ixx>0.1</ixx><ixy>0</ixy><iyy>0.1</iyy>
          <ixz>0</ixz><iyz>0</iyz><izz>0.1</izz>
        </inertia>
      </inertial>

      <!-- 立杆 -->
      <collision name="pole_collision">
        <pose>0 0 1.5 0 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>3.0</length></cylinder></geometry>
      </collision>
      <visual name="pole_visual">
        <pose>0 0 1.5 0 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>3.0</length></cylinder></geometry>
        <material>
          <ambient>0.4 0.4 0.4 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
        </material>
      </visual>

      <!-- 横臂 -->
      <visual name="arm_visual">
        <pose>0.8 0 2.8 0 0 0</pose>
        <geometry><box><size>1.6 0.06 0.06</size></box></geometry>
        <material>
          <ambient>0.4 0.4 0.4 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
        </material>
      </visual>
      <collision name="arm_collision">
        <pose>0.8 0 2.8 0 0 0</pose>
        <geometry><box><size>1.6 0.06 0.06</size></box></geometry>
      </collision>

      <!-- 摄像头外壳 -->
      <visual name="camera_housing">
        <pose>1.5 0 2.7 0 0.3 0</pose>
        <geometry><box><size>0.3 0.2 0.15</size></box></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>

      <!-- 摄像头传感器 -->
      <sensor name="camera_sensor" type="camera">
        <pose>1.5 0 2.7 0 0.3 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <camera name="pole_camera">
          <horizontal_fov>1.2</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>100</far>
          </clip>
        </camera>
        <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/camera_pole</namespace>
            <remapping>~/image_raw:=camera/image_raw</remapping>
            <remapping>~/camera_info:=camera/camera_info</remapping>
          </ros>
          <camera_name>camera</camera_name>
          <frame_name>camera_pole/camera_link</frame_name>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
