<?xml version="1.0"?>
<model>
  <name>V2X Smart Car (Configurable)</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf.template</sdf>

  <author>
    <name>V2X Dev</name>
    <email>dev@example.com</email>
  </author>

  <description>
    可配置参数智能小车模板。通过 smart_car_config.yaml 设定尺寸、轮距、
    最大速度、加速度等物理参数，由 car_generator.py 动态生成 SDF 并注入 Gazebo。
    内置 LiDAR / Camera / IMU / 里程计，标准 ROS2 话题输出，兼容 Nav2。
  </description>
</model>
