<?xml version="1.0"?>
<sdf version="1.6">
  <world name="room_layout">
    <!-- 物理引擎 -->
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step>0.001</max_step>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.0</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- 场景 -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- GUI 相机初始位置（靠近房间，便于观察） -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>15 -10 8 0 -0.5 1.5708</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- 太阳光（内联定义，避免在线查询） -->
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 地面（深色沥青风格，参照效果图） -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 房间 OBJ 均为 Y-up（Blender 导出约定），Gazebo 为 Z-up，
         故每个房间绕 X 轴 +90°(roll=1.5708) 才能平躺在地面 -->

    <!-- 33平米房间 -->
    <model name="room_33">
      <static>true</static>
      <pose>0 0 0 1.5708 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>model://room_33/meshes/room_33.obj</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://room_33/meshes/room_33.obj</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- 20平米房间 -->
    <model name="room_20">
      <static>true</static>
      <pose>15 0 0 1.5708 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>model://room_20/meshes/room_20.obj</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://room_20/meshes/room_20.obj</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- 12平米房间 -->
    <model name="room_12">
      <static>true</static>
      <pose>30 0 0 1.5708 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>model://room_12/meshes/room_12.obj</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://room_12/meshes/room_12.obj</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- ==================== 智能小车（放在 room_33 内部路面上） ==================== -->
    <!-- room_33 局部坐标: X∈[-3,3], Y(高)∈[0,3.5], Z(深)∈[-1,4.4]
         roll=π/2 映射: Xw=Xl, Yw=-Zl, Zw=Yl
         局部(0,1.5,0.15) → 世界(0,-0.15,1.5) 在房间内部 -->
    <model name="smart_car_1">
      <pose>0 -0.15 0.15 0 0 0</pose>
      <link name="chassis">
        <inertial>
          <mass>80.00</mass>
          <pose>0 0 0 0 0 0</pose>
          <inertia>
            <ixx>2.1333</ixx><ixy>0</ixy><iyy>17.0667</iyy>
            <ixz>0</ixz><iyz>0</iyz><izz>17.0667</izz>
          </inertia>
        </inertial>
        <collision name="chassis_collision">
          <pose>0 0 0.2500 0 0 0</pose>
          <geometry><box><size>1.600 0.800 0.400</size></box></geometry>
        </collision>
        <visual name="chassis_body">
          <pose>0 0 0.2500 0 0 0</pose>
          <geometry><box><size>1.600 0.800 0.400</size></box></geometry>
          <material>
            <ambient>0.150 0.450 0.850 1</ambient>
            <diffuse>0.150 0.450 0.850 1</diffuse>
          </material>
        </visual>
        <visual name="cabin">
          <pose>0 -0.0800 0.5700 0 0 0</pose>
          <geometry><box><size>0.720 0.680 0.240</size></box></geometry>
          <material>
            <ambient>0.1 0.1 0.12 1</ambient>
            <diffuse>0.15 0.15 0.18 1</diffuse>
          </material>
        </visual>

        <!-- 前视相机 -->
        <sensor name="camera" type="camera">
          <pose>0.6400 0 0.4800 0 0.3 0</pose>
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <camera name="front_camera">
            <horizontal_fov>1.2</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>100</far>
            </clip>
          </camera>
          <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/smart_car_1</namespace>
              <remapping>~/image_raw:=camera/image_raw</remapping>
              <remapping>~/camera_info:=camera/camera_info</remapping>
            </ros>
            <camera_name>camera</camera_name>
            <frame_name>smart_car_1/camera_link</frame_name>
          </plugin>
        </sensor>

        <!-- LiDAR -->
        <sensor name="lidar" type="ray">
          <pose>0.1600 0 0.5500 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <visualize>true</visualize>
          <ray>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.12</min>
              <max>30.0</max>
              <resolution>0.01</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </ray>
          <plugin name="gazebo_ros_ray_sensor" filename="libgazebo_ros_ray_sensor.so">
            <ros>
              <namespace>/smart_car_1</namespace>
              <remapping>~/out:=scan</remapping>
            </ros>
            <output_type>sensor_msgs/LaserScan</output_type>
            <frame_name>smart_car_1/lidar_link</frame_name>
          </plugin>
        </sensor>

        <!-- IMU -->
        <sensor name="imu_sensor" type="imu">
          <pose>0 0 0.2000 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>200</update_rate>
          <plugin name="gazebo_ros_imu_sensor" filename="libgazebo_ros_imu_sensor.so">
            <ros>
              <namespace>/smart_car_1</namespace>
              <remapping>~/out:=imu/data</remapping>
            </ros>
            <frame_name>smart_car_1/imu_link</frame_name>
            <initial_orientation_as_reference>false</initial_orientation_as_reference>
          </plugin>
        </sensor>
      </link>

      <!-- 左轮 -->
      <link name="left_wheel_link">
        <pose>0.4000 0.3500 0.1000 0 0 0</pose>
        <inertial>
          <mass>2.00</mass>
          <inertia>
            <ixx>0.005067</ixx><iyy>0.010000</iyy><izz>0.005067</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <pose>0 0 0 1.5707963 0 0</pose>
          <geometry>
            <cylinder><radius>0.1000</radius><length>0.0800</length></cylinder>
          </geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><ode><min_depth>0.001</min_depth><kp>1e8</kp></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <pose>0 0 0 1.5707963 0 0</pose>
          <geometry>
            <cylinder><radius>0.1000</radius><length>0.0800</length></cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="left_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>left_wheel_link</child>
        <axis><xyz>0 1 0</xyz>
          <dynamics><friction>0.1</friction></dynamics>
        </axis>
      </joint>

      <!-- 右轮 -->
      <link name="right_wheel_link">
        <pose>0.4000 -0.3500 0.1000 0 0 0</pose>
        <inertial>
          <mass>2.00</mass>
          <inertia>
            <ixx>0.005067</ixx><iyy>0.010000</iyy><izz>0.005067</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <pose>0 0 0 1.5707963 0 0</pose>
          <geometry>
            <cylinder><radius>0.1000</radius><length>0.0800</length></cylinder>
          </geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><ode><min_depth>0.001</min_depth><kp>1e8</kp></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <pose>0 0 0 1.5707963 0 0</pose>
          <geometry>
            <cylinder><radius>0.1000</radius><length>0.0800</length></cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="right_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>right_wheel_link</child>
        <axis><xyz>0 1 0</xyz>
          <dynamics><friction>0.1</friction></dynamics>
        </axis>
      </joint>

      <!-- 后脚轮 -->
      <link name="caster_link">
        <pose>-0.4000 0 0.0600 0 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.0600</radius></sphere></geometry>
          <surface>
            <friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction>
            <contact><ode><min_depth>0.001</min_depth><kp>1e8</kp></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.0600</radius></sphere></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
      <joint name="caster_joint" type="fixed">
        <parent>chassis</parent>
        <child>caster_link</child>
      </joint>

      <!-- 差速驱动插件 -->
      <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
        <ros>
          <namespace>/smart_car_1</namespace>
          <remapping>cmd_vel:=cmd_vel</remapping>
          <remapping>odom:=odom</remapping>
        </ros>
        <update_rate>100</update_rate>
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.7000</wheel_separation>
        <wheel_diameter>0.2000</wheel_diameter>
        <max_wheel_torque>12.00</max_wheel_torque>
        <max_wheel_acceleration>40.00</max_wheel_acceleration>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
        <publish_wheel_tf>true</publish_wheel_tf>
        <odometry_frame>smart_car_1_odom</odometry_frame>
        <robot_base_frame>smart_car_1/base_link</robot_base_frame>
      </plugin>
    </model>

    <!-- ==================== 测速摄像头（放在 room_33 内部高处） ==================== -->
    <!-- 局部(0,3.5,2.2) → 世界(0,-2.2,3.5) -->
    <model name="speed_cam">
      <static>true</static>
      <pose>0 -2.2 3.5 0 -0.3 1.5708</pose>
      <link name="link">
        <!-- 立杆 -->
        <visual name="pole">
          <pose>0 0 -1.5 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
        <collision name="pole_collision">
          <pose>0 0 -1.5 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>3.0</length></cylinder></geometry>
        </collision>
        <!-- 摄像头 -->
        <visual name="camera_box">
          <pose>0 0.3 0 0 0 0</pose>
          <geometry><box><size>0.3 0.2 0.15</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <!-- 摄像头传感器 -->
        <sensor name="speed_camera_sensor" type="camera">
          <pose>0 0.3 0 0 -0.3 0</pose>
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <camera name="speed_cam">
            <horizontal_fov>1.0</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>100</far>
            </clip>
          </camera>
          <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/speed_cam</namespace>
              <remapping>~/image_raw:=camera/image_raw</remapping>
              <remapping>~/camera_info:=camera/camera_info</remapping>
            </ros>
            <camera_name>speed_cam</camera_name>
            <frame_name>speed_cam/camera_link</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- ==================== 路口摄像头（放在 room_20 内部高处） ==================== -->
    <!-- room_20 中心世界(15,0,0)，局部(0,3,2.5) → 世界(15,-2.5,3.5) -->
    <model name="intersection_cam">
      <static>true</static>
      <pose>15 -2.5 3.5 0 -0.4 1.5708</pose>
      <link name="link">
        <!-- 立杆 -->
        <visual name="pole">
          <pose>0 0 -2.0 0 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>4.0</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
        <collision name="pole_collision">
          <pose>0 0 -2.0 0 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>4.0</length></cylinder></geometry>
        </collision>
        <!-- 横臂 -->
        <visual name="arm">
          <pose>1.5 0 0 0 0 0</pose>
          <geometry><box><size>3.0 0.08 0.08</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
        <!-- 摄像头 -->
        <visual name="camera_box">
          <pose>2.8 0 0.2 0 0 0</pose>
          <geometry><box><size>0.25 0.18 0.15</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <!-- 摄像头传感器 -->
        <sensor name="intersection_camera_sensor" type="camera">
          <pose>2.8 0 0.2 0 -0.4 0</pose>
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <camera name="intersection_cam">
            <horizontal_fov>1.4</horizontal_fov>
            <image>
              <width>800</width>
              <height>600</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>150</far>
            </clip>
          </camera>
          <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/intersection_cam</namespace>
              <remapping>~/image_raw:=camera/image_raw</remapping>
              <remapping>~/camera_info:=camera/camera_info</remapping>
            </ros>
            <camera_name>intersection_cam</camera_name>
            <frame_name>intersection_cam/camera_link</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- Gazebo ROS 插件 -->
    <plugin name="gazebo_ros_init" filename="libgazebo_ros_init.so"/>
    <plugin name="gazebo_ros_factory" filename="libgazebo_ros_factory.so"/>
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so"/>
  </world>
</sdf>
