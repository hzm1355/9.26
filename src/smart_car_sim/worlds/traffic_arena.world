          <geometry><sphere><radius>0.09</radius></sphere></geometry>
          <material><ambient>0 0.45 0 1</ambient><diffuse>0 0.5 0 1</diffuse></material>
        </visual>
      </link>
      <plugin name="v2x_traffic_light" filename="libv2x_traffic_light.so">
        <state_topic>traffic_light/J1_ns/state</state_topic>
        <link_name>link</link>
        <is_pedestrian>false</is_pedestrian>
      </plugin>
    </model>

    <!-- ==================== 行人信号灯 ==================== -->
    <!-- 北侧行人灯 -->
    <model name="PED_N">
      <static>true</static>
      <pose>4.5 5.5 0 0 0 3.14159</pose>
      <link name="link">
        <visual name="pole">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <collision name="pole_c">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>1.5</length></cylinder></geometry>
        </collision>
        <visual name="housing">
          <pose>0 0 1.55 0 0 0</pose>
          <geometry><box><size>0.14 0.20 0.40</size></box></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
        </visual>
        <visual name="red_hand">
          <pose>0.08 0 1.65 0 0 0</pose>
          <geometry><sphere><radius>0.07</radius></sphere></geometry>
          <material><ambient>0.45 0 0 1</ambient><diffuse>0.5 0 0 1</diffuse><emissive>0.9 0.05 0.05 1</emissive></material>
        </visual>
        <visual name="green_walking">
          <pose>0.08 0 1.45 0 0 0</pose>
          <geometry><sphere><radius>0.07</radius></sphere></geometry>
          <material><ambient>0 0.45 0 1</ambient><diffuse>0 0.5 0 1</diffuse></material>
        </visual>
      </link>
      <plugin name="v2x_traffic_light" filename="libv2x_traffic_light.so">
        <state_topic>traffic_light/J1_ns/pedestrian</state_topic>
        <link_name>link</link_name>
        <is_pedestrian>true</is_pedestrian>
      </plugin>
    </model>

    <!-- 南侧行人灯 -->
    <model name="PED_S">
      <static>true</static>
      <pose>-4.5 -5.5 0 0 0 0</pose>
      <link name="link">
        <visual name="pole">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
