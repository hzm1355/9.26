    <model name="parking_gantry">
      <static>true</static>
      <pose>9.4000 -7.0500 6.7000 0.0000 0.0000 0.0000</pose>
      <!-- 相机吊在两条车道中心线的正上方、且整体退到镜头平面之后（任务三 v2 的教训：横臂前伸 6 cm 就抓到 82% 自家立杆）。本模型带 camera sensor，运行期绝不可 delete_entity。 -->
      <link name="link">
        <visual name="mast1">
          <pose>-3.3500 0.0000 1.3250 0.0000 0.0000 0.0000</pose>
          <geometry><cylinder><radius>0.0900</radius><length>2.6500</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.45 0.45 0.50 1</diffuse><specular>0 0 0 1</specular><emissive>0 0 0 1</emissive></material>
        </visual>
        <collision name="mast1_col">
          <pose>-3.3500 0.0000 1.3250 0.0000 0.0000 0.0000</pose>
          <geometry><cylinder><radius>0.0900</radius><length>2.6500</length></cylinder></geometry>
        </collision>
        <visual name="mast1_base">
          <pose>-3.3500 0.0000 0.0400 0.0000 0.0000 0.0000</pose>
          <geometry><cylinder><radius>0.2160</radius><length>0.0800</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.06 1</ambient><diffuse>0.15 0.15 0.18 1</diffuse><specular>0 0 0 1</specular><emissive>0 0 0 1</emissive></material>
        </visual>
        <visual name="mast2">
          <pose>3.3500 0.0000 1.3250 0.0000 0.0000 0.0000</pose>
          <geometry><cylinder><radius>0.0900</radius><length>2.6500</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.45 0.45 0.50 1</diffuse><specular>0 0 0 1</specular><emissive>0 0 0 1</emissive></material>
        </visual>
        <collision name="mast2_col">
          <pose>3.3500 0.0000 1.3250 0.0000 0.0000 0.0000</pose>
          <geometry><cylinder><radius>0.0900</radius><length>2.6500</length></cylinder></geometry>
        </collision>
        <visual name="mast2_base">
          <pose>3.3500 0.0000 0.0400 0.0000 0.0000 0.0000</pose>
          <geometry><cylinder><radius>0.2160</radius><length>0.0800</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.06 1</ambient><diffuse>0.15 0.15 0.18 1</diffuse><specular>0 0 0 1</specular><emissive>0 0 0 1</emissive></material>
        </visual>
        <visual name="beam">
          <pose>0.0000 0.0000 2.4000 0.0000 0.0000 0.0000</pose>
          <geometry><box><size>6.7000 0.1200 0.1400</size></box></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.45 0.45 0.50 1</diffuse><specular>0 0 0 1</specular><emissive>0 0 0 1</emissive></material>
        </visual>
        <visual name="beam_trim">
          <pose>0.0000 0.0000 2.3100 0.0000 0.0000 0.0000</pose>
          <geometry><box><size>6.7000 0.0720 0.0400</size></box></geometry>
          <material><ambient>0.55 0.46 0.10 1</ambient><diffuse>0.86 0.72 0.16 1</diffuse><specular>0 0 0 1</specular><emissive>0 0 0 1</emissive></material>
        </visual>
        <sensor name="gate_camera_in" type="camera">
          <pose>2.6000 0.0000 2.2500 0.0000 0.4500 -1.5708</pose>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <visualize>false</visualize>
          <camera name="gate_in">
            <horizontal_fov>0.6000</horizontal_fov>
            <image><width>1920</width><height>1080</height><format>R8G8B8</format></image>
            <clip><near>0.0500</near><far>40.0000</far></clip>
          </camera>
          <plugin name="gazebo_ros_camera_gate_in" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/parking</namespace>
            </ros>
            <camera_name>gate_in</camera_name>
            <frame_name>gate_in/camera_link</frame_name>
          </plugin>
          <plugin name="v2x_gate" filename="libv2x_gate.so">
            <gate_id>gate_in</gate_id>
            <capture_dir>/tmp/v2x_parking_in</capture_dir>
            <focus>12.0000 -11.2100 6.8500</focus>
            <near_radius>1.4000</near_radius>
            <far_radius>2.5000</far_radius>
            <frame_wait>3.0000</frame_wait>
            <rearm_on_fail>true</rearm_on_fail>
            <render_lag>0.0000</render_lag>
            <vehicle_prefix>car_</vehicle_prefix>
            <chassis_link>chassis</chassis_link>
            <image_format>R8G8B8</image_format>
          </plugin>
        </sensor>
        <visual name="cambox_in">
          <pose>2.6000 0.0000 2.2500 0.0000 0.0000 0.0000</pose>
          <geometry><box><size>0.3000 0.2000 0.1600</size></box></geometry>
          <material><ambient>0.05 0.05 0.06 1</ambient><diffuse>0.15 0.15 0.18 1</diffuse><specular>0 0 0 1</specular><emissive>0 0 0 1</emissive></material>
        </visual>
        <sensor name="gate_camera_out" type="camera">
