          <pose>-1.45 -0.15 4.70 0.38 0 0</pose>
          <geometry><box><size>0.56 0.30 0.05</size></box></geometry>
          <material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.07 0.07 0.07 1</diffuse></material>
        </visual>
        <collision name="pole_collision">
          <pose>0 0 2.20 0 0 0</pose>
          <geometry><cylinder><radius>0.13</radius><length>4.10</length></cylinder></geometry>
        </collision>
      </link>
      <link name="red_link">
        <pose>-1.45 -0.13 3.55 0 0 0</pose>
        <visual name="red_visual">
          <geometry><sphere><radius>0.15</radius></sphere></geometry>
          <material><ambient>0.05 0 0 1</ambient><diffuse>0.05 0 0 1</diffuse><emissive>0.05 0 0 1</emissive></material>
        </visual>
      </link>
      <link name="yellow_link">
        <pose>-1.45 -0.13 4.05 0 0 0</pose>
        <visual name="yellow_visual">
          <geometry><sphere><radius>0.15</radius></sphere></geometry>
          <material><ambient>0.05 0.05 0 1</ambient><diffuse>0.05 0.05 0 1</diffuse><emissive>0.05 0.05 0 1</emissive></material>
        </visual>
      </link>
      <link name="green_link">
        <pose>-1.45 -0.13 4.55 0 0 0</pose>
        <visual name="green_visual">
          <geometry><sphere><radius>0.15</radius></sphere></geometry>
          <material><ambient>0 0.05 0 1</ambient><diffuse>0 0.05 0 1</diffuse><emissive>0 0.05 0 1</emissive></material>
        </visual>
      </link>
      <plugin name="traffic_light" filename="libtraffic_light_plugin.so">
        <topic>traffic_light/J2_ew/state</topic>
      </plugin>
    </model>

    <!-- J2 南路口西口人行横道行人灯 -->
    <model name="tl_j2_ew_ped">
      <static>true</static>
      <pose>-3.4 -12.4 6.7 0 0 1.5708</pose>
      <link name="link">
        <visual name="base_visual">
          <pose>0 0 0.07 0 0 0</pose>
          <geometry><cylinder><radius>0.22</radius><length>0.14</length></cylinder></geometry>
          <material><ambient>0.10 0.10 0.10 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material>
        </visual>
        <visual name="pole_visual">
          <pose>0 0 1.45 0 0 0</pose>
          <geometry><cylinder><radius>0.075</radius><length>2.80</length></cylinder></geometry>
          <material><ambient>0.16 0.16 0.16 1</ambient><diffuse>0.30 0.30 0.32 1</diffuse></material>
        </visual>
        <visual name="housing_visual">
          <pose>0 0.02 2.75 0 0 0</pose>
          <geometry><box><size>0.50 0.20 1.15</size></box></geometry>
          <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.09 0.09 0.09 1</diffuse></material>
        </visual>
        <visual name="red_hand">
          <pose>0 -0.11 2.45 0 0 0</pose>
          <geometry><sphere><radius>0.13</radius></sphere></geometry>
          <material><ambient>0.05 0 0 1</ambient><diffuse>0.05 0 0 1</diffuse><emissive>0.05 0 0 1</emissive></material>
        </visual>
        <visual name="green_walking">
          <pose>0 -0.11 3.05 0 0 0</pose>
          <geometry><sphere><radius>0.13</radius></sphere></geometry>
          <material><ambient>0 0.05 0 1</ambient><diffuse>0 0.05 0 1</diffuse><emissive>0 0.05 0 1</emissive></material>
        </visual>
        <collision name="pole_collision">
          <pose>0 0 1.45 0 0 0</pose>
          <geometry><cylinder><radius>0.10</radius><length>2.80</length></cylinder></geometry>
        </collision>
      </link>
      <plugin name="traffic_light_ped" filename="libv2x_traffic_light.so">
        <state_topic>traffic_light/J2_ew/pedestrian</state_topic>
        <link_name>link</link_name>
        <is_pedestrian>true</is_pedestrian>
      </plugin>
    </model>


    <!-- ==================== 任务三（三）道路卡口：龙门架 + 帧精确抓拍 ====================
         两处卡口都是"路面外立杆 + 横臂把相机伸到车道中心线正上方 2.5 m"的电子警察形态，
         相机沿车流方向朝下俯拍，拍的是**车尾牌**（车辆驶离相机，车牌面正对镜头）：
           gate_j3_north —— 北环 y=4.6 东行车道，相机朝东（yaw=0），覆盖 Ring A 北直段
           gate_j2_south —— 南环 y=-14.6 西行车道，相机朝西（yaw=3.14159），覆盖 Ring B 南直段

         相机几何是反推出来的，不是随手填的，改任何一个数都要重算：
           相机世界高度 z=9.2，车牌面中心 z=6.85 → 落差 2.35 m；
           俯角 pitch=0.55 rad → 光轴落在车前方 2.35/tan(0.55)=3.833 m 处；
           抓拍距离 = sqrt(2.35^2+3.833^2) = 4.50 m；
           horizontal_fov=0.6 @ 1920 宽 -> 焦距 f = 960/tan(0.3) = 3103 px；
           31.5 度入射角只压缩车牌**高度**（车牌法线水平、视线在竖直面内下倾），
           所以 440x140 mm 的蓝牌在画面里约 303x82 px，按国标 45x90 mm 的字符格排七个字，
           每格只落到约 31x59 px——识别器把校正图画布定在 440x140（1 px/mm）就是为了
           不再往下采样，够参考识别器格内匹配。

         抓拍点 = 光轴与车牌平面的交点，相机沿视线方向前移 3.833 m：
           北环 (-3.167, 4.6, 6.85)   南环 (11.000, -14.6, 6.85)

         抓拍点的 x 不是随便挑的，得躲开沙盘里的地面装置。南环最初定在抓拍点 4.997，
         实机抓到的整帧是一块停车场诱导牌加道闸，车牌根本不在画面里。于是把
         room_33 网格换算到世界系（模型 pose roll=90°、mesh scale 10，即
         wx=10*x、wy=-10*z、wz=10*y+6.7），统计"车道中心 ±2 m、路面以上 0.2~2.8 m"
         这条走廊里的顶点数：x 5.5~7.0 稠密（72824 个，就是那块牌子），
         x 7.5~12.5 完全净空，x 16.5~17.0 又稠密（东直段路口构筑物）。
         取抓拍点 11.0 / 相机 14.833，两头都落在净空段内。

         但 <focus> **不等于**抓拍点。v2x_gate 量的是"底盘 link 原点的**画面时刻**位置
         到 focus 的水平距离"，在**接近**侧首次进入 near_radius 的上升沿就抓拍，
         于是有两段固定偏置要补回去：
           1) 触发时车还没到 focus，差一个 near_radius = 1.00 m；
           2) 车尾牌挂在底盘原点后面 0.81 m（plate_rear 的 local x），也就是**更靠近镜头**
              0.81 m，牌比link先到抓拍点。
         所以 focus 要沿车流方向再往前 1.00 + 0.81 = 1.81 m：
           北环 focus x = -3.167 + 1.81 = -1.357（车向东）
           南环 focus x = 11.000 - 1.81 =  9.190（车向西）
         这一段是实测校准出来的：改之前 focus 直接填抓拍点，gate_geom_check.py 量到
         车牌实际只在镜头前 2.02 m（应为 3.83 m），整块牌掉在画面下沿之外。
         far_radius 只要大于 near_radius、又不越过相邻车道（避免邻环车辆反复装填）即可。

         渲染滞后由插件补，不再往 focus 里塞。相机是渲染线程按 update_rate 异步出帧的，
         tools/cam_rate.py 实测 ImageData() 里那帧平均比仿真钟旧 1.1 s。0.7 m/s 时
         这只有 0.77 m，落在取景余量里；2.8 m/s 时同一个滞后是 3.1 m，牌面直接掉出画面。
         所以 v2x_gate 现在按 p_frame = p_now − v·Δt（Δt 取 LastRenderTime 的实际值，
         取不到才退回 <render_lag>）来判触发并回填位姿，focus 保持上面这套 0.7 m/s 标定值。

         立杆件的一条硬规矩：横臂和机壳必须整体退到**镜头平面之后**（北环 local -X、
         南环 local +X，因为南环相机 yaw=180°）。v2 首版把横臂做成与相机同高且前伸
         6 cm，结果 0.06 m 处那片面占满整个画面，抓拍到 82% 是自家立杆。 -->
    <model name="gate_j3_north">
      <static>true</static>
      <!-- 北侧车道 y=4.6 → y=1.5，整套卡口随车道南移 3.1 m（立杆、横臂、机壳、相机、
           focus 的相对几何一字不变，标定继续有效） -->
      <pose>-7.0 4.9 6.7 0 0 0</pose>
      <link name="link">
        <visual name="mast">
          <pose>0 0 1.8 0 0 0</pose>
          <geometry><cylinder><radius>0.09</radius><length>3.6</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material>
        </visual>
        <visual name="base">
          <pose>0 0 0.08 0 0 0</pose>
          <geometry><cylinder><radius>0.28</radius><length>0.16</length></cylinder></geometry>
          <material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.22 0.22 0.25 1</diffuse></material>
        </visual>
        <visual name="arm">
          <pose>-0.28 -1.7 2.62 0 0 0</pose>
          <geometry><box><size>0.10 3.4 0.10</size></box></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material>
        </visual>
        <visual name="camera_box">
          <pose>-0.22 -3.4 2.56 0 0 0</pose>
          <geometry><box><size>0.30 0.20 0.16</size></box></geometry>
          <material><ambient>0.05 0.05 0.06 1</ambient><diffuse>0.15 0.15 0.18 1</diffuse></material>
        </visual>
        <collision name="mast_collision">
          <pose>0 0 1.8 0 0 0</pose>
          <geometry><cylinder><radius>0.09</radius><length>3.6</length></cylinder></geometry>
        </collision>

        <sensor name="gate_camera" type="camera">
          <pose>0 -3.4 2.5 0 0.55 0</pose>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <visualize>false</visualize>
          <camera name="gate_cam">
            <horizontal_fov>0.6</horizontal_fov>
            <image>
              <width>1920</width>
              <height>1080</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.05</near><far>40</far></clip>
          </camera>
          <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/gate_j3_north</namespace>
              <remapping>~/image_raw:=camera/image_raw</remapping>
              <remapping>~/camera_info:=camera/camera_info</remapping>
            </ros>
            <camera_name>gate_cam</camera_name>
            <frame_name>gate_j3_north/camera_link</frame_name>
          </plugin>
          <plugin name="v2x_gate" filename="libv2x_gate.so">
            <gate_id>gate_j3_north</gate_id>
            <capture_dir>/tmp/v2x_gates</capture_dir>
            <focus>-1.357 1.5 6.85</focus>
            <near_radius>1.0</near_radius>
            <far_radius>4.0</far_radius>
            <render_lag>0.0</render_lag>
            <vehicle_prefix>car_</vehicle_prefix>
            <chassis_link>chassis</chassis_link>
            <image_format>R8G8B8</image_format>
          </plugin>
        </sensor>
      </link>
    </model>

    <model name="gate_j2_south">
      <static>true</static>
      <!-- 南侧车道 y=-14.6 → y=-16.8，整套卡口随车道南移 2.2 m：相机镜头中心落到新车道
           正上方，立杆从东车道 x=14.5 的走廊里让到东南路缘（与两条走廊各留 ~1 m）。
           横臂/机壳/focus 的相对几何一字不变，任务三那套标定继续有效。 -->
      <pose>14.833 -20.2 6.7 0 0 0</pose>
      <link name="link">
        <visual name="mast">
          <pose>0 0 1.8 0 0 0</pose>
          <geometry><cylinder><radius>0.09</radius><length>3.6</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material>
        </visual>
        <visual name="base">
          <pose>0 0 0.08 0 0 0</pose>
          <geometry><cylinder><radius>0.28</radius><length>0.16</length></cylinder></geometry>
          <material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.22 0.22 0.25 1</diffuse></material>
        </visual>
        <visual name="arm">
          <!-- 南环相机 yaw=180°，link 系的 -X 才是镜头前方，所以横臂/机壳要放在 +X 侧 -->
          <pose>0.28 1.7 2.62 0 0 0</pose>
          <geometry><box><size>0.10 3.4 0.10</size></box></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material>
        </visual>
        <visual name="camera_box">
          <pose>0.22 3.4 2.56 0 0 0</pose>
          <geometry><box><size>0.30 0.20 0.16</size></box></geometry>
          <material><ambient>0.05 0.05 0.06 1</ambient><diffuse>0.15 0.15 0.18 1</diffuse></material>
        </visual>
        <collision name="mast_collision">
          <pose>0 0 1.8 0 0 0</pose>
          <geometry><cylinder><radius>0.09</radius><length>3.6</length></cylinder></geometry>
        </collision>

        <sensor name="gate_camera" type="camera">
          <pose>0 3.4 2.5 0 0.55 3.14159265</pose>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <visualize>false</visualize>
          <camera name="gate_cam">
            <horizontal_fov>0.6</horizontal_fov>
            <image>
              <width>1920</width>
              <height>1080</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.05</near><far>40</far></clip>
          </camera>
          <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/gate_j2_south</namespace>
              <remapping>~/image_raw:=camera/image_raw</remapping>
              <remapping>~/camera_info:=camera/camera_info</remapping>
            </ros>
            <camera_name>gate_cam</camera_name>
            <frame_name>gate_j2_south/camera_link</frame_name>
          </plugin>
          <plugin name="v2x_gate" filename="libv2x_gate.so">
            <gate_id>gate_j2_south</gate_id>
            <capture_dir>/tmp/v2x_gates</capture_dir>
            <focus>9.19 -16.8 6.85</focus>
            <near_radius>1.0</near_radius>
            <far_radius>4.0</far_radius>
            <render_lag>0.0</render_lag>
            <vehicle_prefix>car_</vehicle_prefix>
            <chassis_link>chassis</chassis_link>
            <image_format>R8G8B8</image_format>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- 车牌贴牌管理器：任务三（三）。承载 v2x_plate 插件，
         订阅 /plate/set 给五辆车换车牌材质。本体埋在地下，不参与交通。 -->
    <model name="plate_manager">
      <static>true</static>
      <pose>0 0 -0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.02 0.02 0.02</size></box></geometry>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin name="v2x_plate" filename="libv2x_plate.so">
        <set_topic>/plate/set</set_topic>
        <plate_dir>/tmp/v2x_plates</plate_dir>
        <chassis_link>chassis</chassis_link>
      </plugin>
    </model>

    <!-- ==================== 任务三（三）条目 3：卡口补光灯 + 光照预设 ====================
         电子警察晚上是真带补光灯的，所以夜间预设不是"把画面调黑"而是"关掉太阳、只留补光"。
         灯型选 point 而不是 spot：spot 的光轴在本体系是 -Z，要靠姿态或 <direction>
         转过来，而实测这两条在 Gazebo 11 里哪条被采纳没有保证（spot 版夜间档南环整幅
         最亮只有 17，说明光轴压根没指到取景中心）。point 各向同性，摆位对了就亮。

         位置就在各自相机旁边（北 -7.22 4.6 9.26 / 南 15.05 -14.6 9.26，跟 camera_box
         的世界坐标重合）：真实卡口的频闪灯就装在相机两侧，到牌面的距离由抓拍点决定，
         北环 (-3.167,4.6) / 南环 (11.0,-14.6)、牌面中心 z≈0.55 → 约 9.6 m。

         衰减参数是被实测逼出来的：quadratic 0.02 时 9.6 m 处只剩 1/(1+0.02·92)≈0.35，
         开关灯量不出差别；把灯临时挪到牌面上方 3 m 才第一次看到可重复的差异
         （南环最亮 6→16、灰度级 1→3），而把 fill_diffuse 从 1.8 提到 30 并不更亮——
         这版 Gazebo 的灯亮度在 1 附近就被夹住了，靠加亮度补不回距离。
         所以改成放松衰减：quadratic 0.002 + range 60 → 9.6 m 处衰减 0.84。

         <diffuse> 初值给 0：插件的 <default>是 none，启动时不改任何灯，
         初值 0 才能保证白天基线里这两盏灯是真灭的，不被它们污染。 -->
    <light name="gate_j3_north_fill" type="point">
      <pose>-7.22 4.6 9.26 0 0 0</pose>
      <diffuse>0 0 0 1</diffuse>
      <specular>0 0 0 1</specular>
      <attenuation>
        <range>60</range><constant>1</constant><linear>0</linear><quadratic>0.002</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light name="gate_j2_south_fill" type="point">
      <pose>15.05 -14.6 9.26 0 0 0</pose>
      <diffuse>0 0 0 1</diffuse>
      <specular>0 0 0 1</specular>
      <attenuation>
        <range>60</range><constant>1</constant><linear>0</linear><quadratic>0.002</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- 光照预设切换：订阅 ROS2 /gate/lighting（day/backlit/lowlight/night）。
         default=none 表示启动时不改 world 里的 <scene>，保持白天基线。
         fill_diffuse 是夜间档给补光灯的亮度；这版 Gazebo 的灯亮度在 1 附近就被
         夹住（实测 1.8 与 30 量不出差别），所以取 1.0，剩下的靠衰减参数调。 -->
    <plugin name="v2x_lighting" filename="libv2x_lighting.so">
      <default>none</default>
      <fill_lights>gate_j3_north_fill,gate_j2_south_fill</fill_lights>
      <fill_diffuse>1.0</fill_diffuse>
    </plugin>

    <!-- ════ BEGIN GENERATED: parking（tools/gen_parking_world.py 生成，勿手改）════
         数据源：src/v2x_demo/config/parking_zones.yaml（唯一真值来源）
         重生成：python3 tools/gen_parking_world.py
         改点位请改 yaml 再重跑本脚本 + tools/check_parking_layout.py，
         直接改这一段会在下次生成时被整块覆盖掉。
    -->
    <model name="parking_floor">
      <static>true</static>
      <pose>11.1500 -9.6500 6.7000 0.0000 0.0000 0.0000</pose>
      <link name="link">
        <visual name="asphalt">
          <pose>0.0000 0.0000 -0.0130 0.0000 0.0000 0.0000</pose>
          <geometry><box><size>10.7000 8.3000 0.0500</size></box></geometry>
          <material><ambient>0.07 0.14 0.09 1</ambient><diffuse>0.18 0.38 0.22 1</diffuse><specular>0 0 0 1</specular><emissive>0 0 0 1</emissive></material>
        </visual>
      </link>
    </model>

    <model name="parking_stripes">
      <static>true</static>
      <pose>11.1500 -9.6500 6.7000 0.0000 0.0000 0.0000</pose>
      <link name="link">
        <visual name="s001">
          <pose>11.1500 -13.8000 0.0210 0 0 0.0000</pose>
          <geometry><box><size>10.7000 0.1000 0.0120</size></box></geometry>
          <material><ambient>0.55 0.55 0.52 1</ambient><diffuse>0.86 0.86 0.82 1</diffuse><specular>0 0 0 1</specular><emissive>0 0 0 1</emissive></material>
        </visual>
        <visual name="s002">
          <pose>11.1500 -5.5000 0.0210 0 0 0.0000</pose>
          <geometry><box><size>10.7000 0.1000 0.0120</size></box></geometry>
          <material><ambient>0.55 0.55 0.52 1</ambient><diffuse>0.86 0.86 0.82 1</diffuse><specular>0 0 0 1</specular><emissive>0 0 0 1</emissive></material>
        </visual>
        <visual name="s003">
          <pose>5.8000 -9.6500 0.0210 0 0 1.5708</pose>
