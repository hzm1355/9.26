    <!-- ===== 新增车辆 car_3/car_4/car_5（由 car_2 模板复制，差速驱动 + 独立命名空间） ===== -->
    <model name="car_3">
      <!-- 2026-10-14 出生位从 Ring A 南行车道 (-0.8,-5.0) 挪到停车场入口等待位：
           任务五用它演"白名单月租车"那条分支，由 parking_shuttle_node 按
           parking_zones.yaml 的 shuttle.fleets.car_3 驱动。这一格与 car_6 的出生位
           同一套标定（等待位在入口闸杆轴以南 1.75 m、离相机 focus 1.59 m，
           在 near_radius 1.4 之外，所以第一脚油门到核验位的抓拍上升沿成立）。
           2026-10-16 随 fleets.car_3 等待位一起南移到 (12.00,-13.95)：1.59 m 那个
           旧值离 gate_in 的 far_radius 2.5 太近，reset 末段原地转会把底盘原点甩进
           near_radius 1.4 误拍一帧并永久置 armed（第二轮零抓拍的成因）。南移后静止
           离 focus 2.74 m > far 2.5，每轮回等待位自动清锁；z 仍 7.0000 自由落体到
           台面 6.70，该格落地障碍高度图 0 格（tools/lot_clearance.py）。 -->
      <pose>12.0000 -13.9500 7.0000 0 0 1.5708</pose>

