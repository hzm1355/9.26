<?xml version="1.0"?>
<sdf version="1.6">
  <world name="v2x_city_scene">
    <!-- 物理引擎 -->
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step>0.001</max_step>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.0</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- 场景 -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- GUI 相机初始位置（俯视整个 50m 城市） -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 -70 50 0 0.57 1.5708</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- 太阳光 -->
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 地面（深色沥青） -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== 房间模型 ==================== -->
    <!-- 房间 OBJ 均为 Y-up（Blender 导出），Gazebo 为 Z-up，
         故每个房间绕 X 轴 +90°(roll=1.5708) 才能平躺在地面 -->

    <!-- 33平米房间（实际为城市沙盘，5m 桌面尺寸，放大 10 倍成 50m 城市） -->
    <model name="room_33">
      <static>true</static>
      <pose>0 0 6.7 1.5708 0 0</pose>
      <link name="link">
        <!-- OBJ 三角形过多导致 ODE 三角网格碰撞失效，改用等效盒体：顶面=路面 z=6.7 -->
        <collision name="collision">
          <pose>0 -3.35 -0.5 0 0 0</pose>
          <geometry>
            <box><size>50 6.7 51.2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://room_33/meshes/room_33.obj</uri>
              <scale>10 10 10</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- 建筑群隐形碰撞盒（供 LiDAR/避障使用，视觉由沙盘网格提供）
         尺寸按沙盘实际楼块轮廓收紧，保证各条车道中心距盒面 >=1.5 m，避免车辆顶墙卡死 -->
    <model name="bldg_school">
      <static>true</static>
      <!-- 轮廓按 tools/bldg_box_fit.py 对到网格实影（学校楼体实测 x -13.75..-3.50、
           y -12.75..-5.00，四边各留 0.3 m）。旧盒往北多画到 y=1.0，正好压在北侧
           新车道 y=1.5 的车体走廊上，会把车拦住 —— 那里网格根本没有墙。 -->
      <pose>-8.62 -8.88 9.2 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>10.85 8.35 5</size></box></geometry></collision></link>
    </model>
    <model name="bldg_nw">
      <static>true</static>
      <pose>-13.5 12.5 9.7 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>9 9 6</size></box></geometry></collision></link>
    </model>
    <model name="bldg_tower_w">
      <static>true</static>
      <pose>-4 14 10.7 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>7 7 8</size></box></geometry></collision></link>
    </model>
    <model name="bldg_tower_e">
      <static>true</static>
      <pose>9 14 10.7 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>7 7 8</size></box></geometry></collision></link>
    </model>
    <model name="bldg_ne">
      <static>true</static>
      <pose>17 13.2 9.7 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>9 9 6</size></box></geometry></collision></link>
    </model>

    <!-- 20平米房间（ meshes 为重复沙盘，暂不加载） -->
    <!--
    <model name="room_20">
      <static>true</static>
      <pose>15 0 0 1.5708 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>model://room_20/meshes/room_20.obj</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://room_20/meshes/room_20.obj</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>
    -->

    <!-- 12平米房间（meshes 缺失，暂不加载） -->
    <!--
    <model name="room_12">
      <static>true</static>
      <pose>30 0 0 1.5708 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>model://room_12/meshes/room_12.obj</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://room_12/meshes/room_12.obj</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>
    -->

    <!-- ==================== 智能小车 car_1（南侧环路上） ==================== -->
    <model name="car_1">
      <pose>-21.8 -5.0 7.0 0 0 1.5708</pose>

      <!-- 底盘 -->
      <link name="chassis">
        <inertial>
          <mass>80.0</mass>
          <pose>0 0 0 0 0 0</pose>
          <inertia>
            <ixx>2.13</ixx><ixy>0</ixy><iyy>17.07</iyy>
            <ixz>0</ixz><iyz>0</iyz><izz>17.07</izz>
          </inertia>
        </inertial>

        <collision name="chassis_collision">
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><box><size>1.6 0.8 0.4</size></box></geometry>
        </collision>

        <visual name="chassis_body">
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><box><size>1.6 0.8 0.4</size></box></geometry>
          <material>
            <ambient>0.1 0.4 0.8 1</ambient>
            <diffuse>0.1 0.4 0.8 1</diffuse>
          </material>
        </visual>

        <!-- 驾驶舱 -->
        <!-- 车牌面片：占位材质由 plate_gen_node 渲染，运行时由 v2x_plate 插件 SetMaterial 替换 -->
        <visual name="plate_rear">
          <pose>-0.81 0 0.15 0 0 3.14159265358979</pose>
          <geometry><box><size>0.02 0.44 0.14</size></box></geometry>
          <material><script>
            <uri>file:///tmp/v2x_plates/placeholder/placeholder.material</uri>
            <name>v2x/plate_placeholder</name>
          </script></material>
        </visual>
        <visual name="plate_front">
          <pose>0.81 0 0.15 0 0 0</pose>
          <geometry><box><size>0.02 0.44 0.14</size></box></geometry>
          <material><script>
            <uri>file:///tmp/v2x_plates/placeholder/placeholder.material</uri>
            <name>v2x/plate_placeholder</name>
          </script></material>
        </visual>
        <visual name="cabin">
          <pose>0 -0.08 0.57 0 0 0</pose>
          <geometry><box><size>0.72 0.68 0.24</size></box></geometry>
          <material>
            <ambient>0.1 0.1 0.12 1</ambient>
            <diffuse>0.15 0.15 0.18 1</diffuse>
          </material>
        </visual>

        <!-- 前视相机 -->
        <sensor name="camera" type="camera">
          <pose>0.6 0 0.75 0 0.15 0</pose>
          <always_on>true</always_on>
          <update_rate>5</update_rate>
          <visualize>true</visualize>
          <camera name="front_camera">
            <horizontal_fov>1.2</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>100</far>
            </clip>
          </camera>
          <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/car_1</namespace>
              <remapping>~/image_raw:=camera/image_raw</remapping>
              <remapping>~/camera_info:=camera/camera_info</remapping>
            </ros>
            <camera_name>camera</camera_name>
            <frame_name>car_1/camera_link</frame_name>
          </plugin>
        </sensor>

        <!-- LiDAR -->
        <sensor name="lidar" type="ray">
          <pose>0.16 0 0.55 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <visualize>true</visualize>
          <ray>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.12</min>
              <max>30.0</max>
              <resolution>0.01</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </ray>
          <plugin name="gazebo_ros_ray_sensor" filename="libgazebo_ros_ray_sensor.so">
            <ros>
              <namespace>/car_1</namespace>
              <remapping>~/out:=scan</remapping>
            </ros>
            <output_type>sensor_msgs/LaserScan</output_type>
            <frame_name>car_1/lidar_link</frame_name>
          </plugin>
        </sensor>

        <!-- IMU -->
        <sensor name="imu_sensor" type="imu">
          <pose>0 0 0.20 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>200</update_rate>
          <plugin name="gazebo_ros_imu_sensor" filename="libgazebo_ros_imu_sensor.so">
            <ros>
              <namespace>/car_1</namespace>
              <remapping>~/out:=imu/data</remapping>
            </ros>
            <frame_name>car_1/imu_link</frame_name>
            <initial_orientation_as_reference>false</initial_orientation_as_reference>
          </plugin>
        </sensor>
      </link>

      <!-- 左轮 -->
      <link name="left_wheel_link">
        <pose>0.40 0.35 0.10 0 0 0</pose>
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.005067</ixx><iyy>0.010000</iyy><izz>0.005067</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <pose>0 0 0 1.5707963 0 0</pose>
          <geometry>
            <cylinder><radius>0.10</radius><length>0.08</length></cylinder>
          </geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><ode><min_depth>0.001</min_depth><kp>1e8</kp></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <pose>0 0 0 1.5707963 0 0</pose>
          <geometry>
            <cylinder><radius>0.10</radius><length>0.08</length></cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="left_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>left_wheel_link</child>
        <axis><xyz>0 1 0</xyz>
          <dynamics><friction>0.1</friction></dynamics>
        </axis>
      </joint>

      <!-- 右轮 -->
      <link name="right_wheel_link">
        <pose>0.40 -0.35 0.10 0 0 0</pose>
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.005067</ixx><iyy>0.010000</iyy><izz>0.005067</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <pose>0 0 0 1.5707963 0 0</pose>
          <geometry>
            <cylinder><radius>0.10</radius><length>0.08</length></cylinder>
          </geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><ode><min_depth>0.001</min_depth><kp>1e8</kp></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <pose>0 0 0 1.5707963 0 0</pose>
          <geometry>
            <cylinder><radius>0.10</radius><length>0.08</length></cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="right_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>right_wheel_link</child>
        <axis><xyz>0 1 0</xyz>
          <dynamics><friction>0.1</friction></dynamics>
        </axis>
      </joint>

      <!-- 后脚轮 -->
      <link name="caster_link">
        <pose>-0.40 0 0.06 0 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.06</radius></sphere></geometry>
          <surface>
            <friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction>
            <contact><ode><min_depth>0.001</min_depth><kp>1e8</kp></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.06</radius></sphere></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
      <joint name="caster_joint" type="fixed">
        <parent>chassis</parent>
        <child>caster_link</child>
      </joint>

      <!-- 差速驱动插件 -->
      <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
        <ros>
          <namespace>/car_1</namespace>
          <remapping>cmd_vel:=cmd_vel</remapping>
          <remapping>odom:=odom</remapping>
        </ros>
        <update_rate>100</update_rate>
        <cmd_vel_timeout>0.3</cmd_vel_timeout>
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.70</wheel_separation>
        <wheel_diameter>0.20</wheel_diameter>
        <max_wheel_torque>12.0</max_wheel_torque>
        <!-- 40 会让轮速指令瞬间生效，急转时整车甩尾打滑；限到 6 平滑扭矩 -->
        <max_wheel_acceleration>6.0</max_wheel_acceleration>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
        <publish_wheel_tf>true</publish_wheel_tf>
        <odometry_frame>car_1_odom</odometry_frame>
        <robot_base_frame>car_1/base_link</robot_base_frame>
      </plugin>

      <!-- 故障模拟插件 -->
      <plugin name="v2x_fault_sim" filename="libv2x_fault_sim.so">
        <ros>
          <namespace>/car_1</namespace>
        </ros>
        <enabled>false</enabled>
        <fault_type>NONE</fault_type>
        <drift_rate>0.01</drift_rate>
        <lag_seconds>0.5</lag_seconds>
        <sensor_drop_rate>0.3</sensor_drop_rate>
      </plugin>
    </model>

    <!-- ==================== car_2：排队演示车辆 ====================
         复用 car_1 的底盘/轮系/差速驱动参数（含 max_wheel_acceleration=6 防甩尾），
         不带传感器，仅用于多车排队与"等待车辆数量"统计演示。 -->
    <model name="car_2">
      <!-- 2026-10-14 出生位从 Ring B 北行车道 (1.8,-5.0) 挪到停车场入口以南的场外
           排队位：任务五用它演"白名单外→临时车登记"那条分支，由
           parking_shuttle_node 按 parking_zones.yaml 的 shuttle.fleets.car_2 驱动。
           y=-14.60 夹在两条约束中间：离入口相机 focus (12.00,-11.21) 3.39 m，必须
           越过 far_radius 2.5 抓拍才重新武装；又必须与南环西行车道 y=-16.8 的车体
           （-17.2..-16.4）留净空，此处留 1.80 m。
           2026-10-16 搬回 (1.8,-5.0)：car_2 当天按用户指令归队跑 Ring B（它不再由
           parking_shuttle_node 驱动，那一格只剩"占着"的作用），而 car_3 的等待位
           同批写进了它的出生位 (12.00,-13.95) —— 两格只差 0.65 m、同向朝北、车长
           1.60 m，车体在 x 上完全重叠、y 上互穿 0.95 m，gzserver 一加载就把两台一起
           弹开：car_3 甩到 (15.71,-44.06) 掉出台面落到 z≈0，car_2 甩到 (20.81,-16.64)。
           现场读起来像"重启把车崩飞了"，其实是出生格互穿，而手工摆位永远测不到它
           （摆位时另一台早开走了）。这条现在由 tools/pk188_worldprechk316.py 第 5 段
           当场拦住：任意两台的出生格车体必须不相交（含 0.10 m 余量）。
           回到 Ring B 中轴北行那一腿既在车流路线上（起栈后 place_cars.py 会接手摆位），
           又与同环另一台 car_4 (20.8,-5.0) 差 19 m，不与任何车互穿。 -->
      <pose>1.8000 -5.0000 7.0000 0 0 1.5708</pose>

      <link name="chassis">
        <inertial>
          <mass>80.0</mass>
          <pose>0 0 0 0 0 0</pose>
          <inertia>
            <ixx>2.13</ixx><ixy>0</ixy><iyy>17.07</iyy>
            <ixz>0</ixz><iyz>0</iyz><izz>17.07</izz>
          </inertia>
        </inertial>

        <collision name="chassis_collision">
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><box><size>1.6 0.8 0.4</size></box></geometry>
        </collision>

        <visual name="chassis_body">
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><box><size>1.6 0.8 0.4</size></box></geometry>
          <material>
            <ambient>0.15 0.6 0.25 1</ambient>
            <diffuse>0.15 0.6 0.25 1</diffuse>
          </material>
        </visual>

        <!-- 车牌面片：占位材质由 plate_gen_node 渲染，运行时由 v2x_plate 插件 SetMaterial 替换 -->
        <visual name="plate_rear">
          <pose>-0.81 0 0.15 0 0 3.14159265358979</pose>
          <geometry><box><size>0.02 0.44 0.14</size></box></geometry>
          <material><script>
            <uri>file:///tmp/v2x_plates/placeholder/placeholder.material</uri>
            <name>v2x/plate_placeholder</name>
          </script></material>
        </visual>
        <visual name="plate_front">
          <pose>0.81 0 0.15 0 0 0</pose>
          <geometry><box><size>0.02 0.44 0.14</size></box></geometry>
          <material><script>
            <uri>file:///tmp/v2x_plates/placeholder/placeholder.material</uri>
            <name>v2x/plate_placeholder</name>
          </script></material>
        </visual>
        <visual name="cabin">
          <pose>0 -0.08 0.57 0 0 0</pose>
          <geometry><box><size>0.72 0.68 0.24</size></box></geometry>
          <material>
            <ambient>0.1 0.1 0.12 1</ambient>
            <diffuse>0.15 0.15 0.18 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="left_wheel_link">
        <pose>0.40 0.35 0.10 0 0 0</pose>
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.005067</ixx><iyy>0.010000</iyy><izz>0.005067</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <pose>0 0 0 1.5707963 0 0</pose>
          <geometry><cylinder><radius>0.10</radius><length>0.08</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><ode><min_depth>0.001</min_depth><kp>1e8</kp></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <pose>0 0 0 1.5707963 0 0</pose>
