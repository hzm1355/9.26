    <!-- ── 停车场摆渡车 car_6（本函数生成，与五车同底盘）──
         初始位姿取 parking.shuttle.park_pose = [23.5000, -23.5000, 0.0000]
    -->
    <model name="car_6">
      <pose>23.5000 -23.5000 7.0000 0 0 0.0000</pose>

      <link name="chassis">
        <inertial>
