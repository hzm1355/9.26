      <static>true</static>
      <!-- 2026-10-13 从 (5.8,-12.6) 挪到 (3.6,-8.0)：原位的 pole_collision（r=0.10）
           贴着停车场南口袋的复位转点 (6.80,-12.80)，原地转扫掠半径 1.365 m 根本转不开，
           car_6 两次楔在上面（实测 OBB 重叠 -0.041/-0.040 m）。新位离最近行车道
           （x=1.8 纵向线）1.8 m，不碰车队航线，也不碰停车场任何航点的扫掠圆。 -->
      <pose>3.6 -8.0 6.7 0 0 1.5708</pose>
      <link name="link">
        <visual name="base_visual">
          <pose>0 0 0.07 0 0 0</pose>
