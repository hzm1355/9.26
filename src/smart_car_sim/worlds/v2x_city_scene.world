        <visual name="visual">
          <pose>0 0 0 1.5707963 0 0</pose>
          <geometry><cylinder><radius>0.10</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
      <joint name="left_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>left_wheel_link</child>
        <axis><xyz>0 1 0</xyz><dynamics><friction>0.1</friction></dynamics></axis>
      </joint>

      <link name="right_wheel_link">
        <pose>0.40 -0.35 0.10 0 0 0</pose>
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.005067</ixx><iyy>0.010000</iyy><izz>0.005067</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <pose>0 0 0 1.5707963 0 0</pose>
          <geometry><cylinder><radius>0.10</radius><length>0.08</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><ode><min_depth>0.001</min_depth><kp>1e8</kp></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <pose>0 0 0 1.5707963 0 0</pose>
          <geometry><cylinder><radius>0.10</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
      <joint name="right_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>right_wheel_link</child>
        <axis><xyz>0 1 0</xyz><dynamics><friction>0.1</friction></dynamics></axis>
      </joint>

      <link name="caster_link">
        <pose>-0.40 0 0.06 0 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.06</radius></sphere></geometry>
          <surface>
            <friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction>
            <contact><ode><min_depth>0.001</min_depth><kp>1e8</kp></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.06</radius></sphere></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
      <joint name="caster_joint" type="fixed">
        <parent>chassis</parent>
        <child>caster_link</child>
      </joint>

      <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
        <ros>
          <namespace>/car_5</namespace>
          <remapping>cmd_vel:=cmd_vel</remapping>
          <remapping>odom:=odom</remapping>
        </ros>
        <update_rate>100</update_rate>
        <cmd_vel_timeout>0.3</cmd_vel_timeout>
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.70</wheel_separation>
        <wheel_diameter>0.20</wheel_diameter>
        <max_wheel_torque>12.0</max_wheel_torque>
        <max_wheel_acceleration>6.0</max_wheel_acceleration>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>false</publish_odom_tf>
        <publish_wheel_tf>false</publish_wheel_tf>
        <odometry_frame>car_5_odom</odometry_frame>
        <robot_base_frame>car_5/base_link</robot_base_frame>
      </plugin>
    </model>

    <!-- ==================== 测速摄像头 speed_cam（南侧环路上方） ==================== -->
    <model name="speed_cam">
      <static>true</static>
      <pose>0 -23 12.7 0 0 0</pose>
      <link name="link">
        <!-- 立杆 -->
        <visual name="pole">
          <pose>0 0 -3 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>6.0</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
        <collision name="pole_collision">
          <pose>0 0 -3 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>6.0</length></cylinder></geometry>
        </collision>

        <!-- 摄像头外壳 -->
        <visual name="camera_box">
          <pose>0 0.3 0 0 0 0</pose>
          <geometry><box><size>0.3 0.2 0.15</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>

        <!-- 摄像头传感器 -->
        <sensor name="speed_camera_sensor" type="camera">
          <pose>0 0.3 0 0 0.5 0</pose>
          <always_on>true</always_on>
          <update_rate>5</update_rate>
          <visualize>true</visualize>
          <camera name="speed_cam">
            <horizontal_fov>1.0</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>100</far>
            </clip>
          </camera>
          <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/speed_cam</namespace>
              <remapping>~/image_raw:=camera/image_raw</remapping>
              <remapping>~/camera_info:=camera/camera_info</remapping>
            </ros>
            <camera_name>speed_cam</camera_name>
            <frame_name>speed_cam/camera_link</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- ==================== 路口摄像头 intersection_cam（东南角俯视中心路口） ==================== -->
    <model name="intersection_cam">
      <static>true</static>
      <pose>20 -20 14.7 0 0 2.356</pose>
      <link name="link">
        <!-- 立杆 -->
        <visual name="pole">
          <pose>0 0 -4 0 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>8.0</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
        <collision name="pole_collision">
          <pose>0 0 -4 0 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>8.0</length></cylinder></geometry>
        </collision>

        <!-- 横臂 -->
        <visual name="arm">
          <pose>1.5 0 0 0 0 0</pose>
          <geometry><box><size>3.0 0.08 0.08</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>

        <!-- 摄像头外壳 -->
        <visual name="camera_box">
          <pose>2.8 0 0.2 0 0 0</pose>
          <geometry><box><size>0.25 0.18 0.15</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>

        <!-- 摄像头传感器 -->
        <sensor name="intersection_camera_sensor" type="camera">
          <pose>2.8 0 0.2 0 0.45 0</pose>
          <always_on>true</always_on>
          <update_rate>5</update_rate>
          <visualize>true</visualize>
          <camera name="intersection_cam">
            <horizontal_fov>1.4</horizontal_fov>
            <image>
              <width>800</width>
              <height>600</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>150</far>
            </clip>
          </camera>
          <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/intersection_cam</namespace>
              <remapping>~/image_raw:=camera/image_raw</remapping>
              <remapping>~/camera_info:=camera/camera_info</remapping>
            </ros>
            <camera_name>intersection_cam</camera_name>
            <frame_name>intersection_cam/camera_link</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- ==================== 监控摄像头 monitor_cam（西北角俯视） ==================== -->
    <model name="monitor_cam">
      <static>true</static>
      <pose>-20 20 14.7 0 0 -0.785</pose>
      <link name="link">
        <!-- 立杆 -->
        <visual name="pole">
          <pose>0 0 -4 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>8.0</length></cylinder></geometry>
