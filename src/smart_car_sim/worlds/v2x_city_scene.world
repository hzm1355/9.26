          </plugin>
        </sensor>
      </link>
    </model>

    <!-- ==================== 信号灯（协议 §三.(二) 信号灯配时仿真） ====================
         路口：J1 中心 (0,-5)（NS 路 x=0 与 EW 路 y=-5 相交），J2 中心 (0,-17)
         停车线：J1_ns 北向 y=-11 / J1_ew 东向 x=-11 / J2_ns 北向 y=-14

         灯型设计（柱式 + 短横臂，灯箱朝向来车方向）：
           pole_link  = 底座 + 立杆 + 横臂 + 灯箱外壳 + 三块遮光罩（不参与点灯）
           red_link / yellow_link / green_link = 灯球，visual 名 red_visual 等，
             这是 libtraffic_light_plugin.so 依赖的命名（model::red_link::red_visual），
             改造型时不能改这些名字。
           模型局部坐标系：灯面朝向 -Y，横臂沿 -X 伸出；用 <pose> 的 yaw 转到实际朝向。

         行人灯：libv2x_traffic_light.so（is_pedestrian），visual 名 red_hand / green_walking
         灯态话题由 traffic_light_manager 发布：traffic_light/<组>/state 与 /pedestrian -->
    <model name="tl_j1_ns">
      <static>true</static>
      <pose>4.2 -10.2 6.7 0 0 0</pose>
      <link name="pole_link">
        <visual name="base_visual">
          <pose>0 0 0.09 0 0 0</pose>
          <geometry><cylinder><radius>0.30</radius><length>0.18</length></cylinder></geometry>
          <material><ambient>0.10 0.10 0.10 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material>
        </visual>
        <visual name="pole_visual">
          <pose>0 0 2.20 0 0 0</pose>
          <geometry><cylinder><radius>0.10</radius><length>4.10</length></cylinder></geometry>
          <material><ambient>0.16 0.16 0.16 1</ambient><diffuse>0.30 0.30 0.32 1</diffuse></material>
        </visual>
        <visual name="arm_visual">
          <pose>-0.75 0 4.05 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>1.60</length></cylinder></geometry>
          <material><ambient>0.16 0.16 0.16 1</ambient><diffuse>0.30 0.30 0.32 1</diffuse></material>
        </visual>
        <visual name="housing_visual">
          <pose>-1.45 0.02 4.05 0 0 0</pose>
          <geometry><box><size>0.62 0.24 1.70</size></box></geometry>
          <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.09 0.09 0.09 1</diffuse></material>
        </visual>
        <visual name="red_visor">
          <pose>-1.45 -0.15 3.70 0.38 0 0</pose>
          <geometry><box><size>0.56 0.30 0.05</size></box></geometry>
          <material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.07 0.07 0.07 1</diffuse></material>
        </visual>
        <visual name="yellow_visor">
          <pose>-1.45 -0.15 4.20 0.38 0 0</pose>
          <geometry><box><size>0.56 0.30 0.05</size></box></geometry>
          <material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.07 0.07 0.07 1</diffuse></material>
        </visual>
        <visual name="green_visor">
          <pose>-1.45 -0.15 4.70 0.38 0 0</pose>
          <geometry><box><size>0.56 0.30 0.05</size></box></geometry>
          <material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.07 0.07 0.07 1</diffuse></material>
        </visual>
        <collision name="pole_collision">
          <pose>0 0 2.20 0 0 0</pose>
          <geometry><cylinder><radius>0.13</radius><length>4.10</length></cylinder></geometry>
        </collision>
      </link>
      <link name="red_link">
        <pose>-1.45 -0.13 3.55 0 0 0</pose>
        <visual name="red_visual">
          <geometry><sphere><radius>0.15</radius></sphere></geometry>
          <material><ambient>0.05 0 0 1</ambient><diffuse>0.05 0 0 1</diffuse><emissive>0.05 0 0 1</emissive></material>
        </visual>
      </link>
      <link name="yellow_link">
        <pose>-1.45 -0.13 4.05 0 0 0</pose>
        <visual name="yellow_visual">
          <geometry><sphere><radius>0.15</radius></sphere></geometry>
          <material><ambient>0.05 0.05 0 1</ambient><diffuse>0.05 0.05 0 1</diffuse><emissive>0.05 0.05 0 1</emissive></material>
        </visual>
      </link>
      <link name="green_link">
        <pose>-1.45 -0.13 4.55 0 0 0</pose>
        <visual name="green_visual">
          <geometry><sphere><radius>0.15</radius></sphere></geometry>
          <material><ambient>0 0.05 0 1</ambient><diffuse>0 0.05 0 1</diffuse><emissive>0 0.05 0 1</emissive></material>
        </visual>
      </link>
      <plugin name="traffic_light" filename="libtraffic_light_plugin.so">
        <topic>traffic_light/J1_ns/state</topic>
      </plugin>
    </model>

    <model name="tl_j1_ew">
      <static>true</static>
      <!-- yaw=-90°：灯面转向 -X（东向来车），横臂沿 +Y 伸到东行车道上方 -->
      <pose>-10.2 6.4 6.7 0 0 -1.5708</pose>
      <link name="pole_link">
        <visual name="base_visual">
          <pose>0 0 0.09 0 0 0</pose>
          <geometry><cylinder><radius>0.30</radius><length>0.18</length></cylinder></geometry>
