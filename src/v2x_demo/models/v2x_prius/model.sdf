<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="v2x_prius">
    <!--
      最小可运行阿克曼车辆骨架：
      - chassis 复用 prius_hybrid 视觉网格（需 GAZEBO_MODEL_PATH 含 gazebo_models-master）
      - 前轮：独立转向关节(steer) + 车轮关节(wheel)，匹配 gazebo_ros_ackermann_drive 插件要求
      - 后轮：驱动轮
      - 传感器：ROS2 版 激光雷达 / IMU / 相机（标准话题输出）
      注意：PID 与 max_speed/max_steer 需按实际质量与轮径微调，见 README「调参」章节。
    -->
    <pose>0 0 0.35 0 0 0</pose>

    <!-- ===================== 底盘 ===================== -->
    <link name="chassis">
      <inertial>
        <mass>1326.0</mass>
        <pose>0 0 0.48 0 0 0</pose>
        <inertia>
          <ixx>2581.0</ixx><ixy>0.0</ixy><iyy>591.0</iyy>
          <ixz>0.0</ixz><iyz>0.0</iyz><izz>2681.0</izz>
        </inertia>
      </inertial>

      <!-- prius 车身视觉（如网格缺失可删除此 visual，改用下方 box 视觉） -->
      <visual name="chassis_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://prius_hybrid/meshes/Hybrid.obj</uri>
            <scale>0.01 0.01 0.01</scale>
            <submesh><name>Hybrid</name><center>false</center></submesh>
          </mesh>
        </geometry>
      </visual>

      <collision name="chassis_collision">
        <pose>0 0 0.625 0 0 0</pose>
        <geometry><box><size>1.75 4.2 0.95</size></box></geometry>
      </collision>

      <!-- ============ 激光雷达（ROS2 ray sensor → /scan） ============ -->
      <sensor name="lidar" type="ray">
        <pose>0 0 1.5 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range><min>0.12</min><max>30.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </ray>
        <plugin name="gazebo_ros_ray_sensor" filename="libgazebo_ros_ray_sensor.so">
          <ros><remapping>~/out:=scan</remapping></ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>laser</frame_name>
        </plugin>
      </sensor>

      <!-- ============ IMU（ROS2 → /imu/data） ============ -->
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 1.0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <plugin name="gazebo_ros_imu_sensor" filename="libgazebo_ros_imu_sensor.so">
          <ros><remapping>~/out:=imu/data</remapping></ros>
          <frame_name>imu_link</frame_name>
          <initial_orientation_as_reference>false</initial_orientation_as_reference>
        </plugin>
      </sensor>

      <!-- ============ 相机（ROS2 → /camera/image_raw） ============ -->
      <sensor name="camera" type="camera">
        <pose>0 -1.9 1.1 0 0 -1.5708</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <camera name="front_camera">
          <horizontal_fov>1.3962634</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.02</near><far>300</far></clip>
        </camera>
        <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
          <ros>
            <remapping>~/image_raw:=camera/image_raw</remapping>
            <remapping>~/camera_info:=camera/camera_info</remapping>
          </ros>
          <camera_name>camera</camera_name>
          <frame_name>camera_link</frame_name>
        </plugin>
      </sensor>
    </link>

    <!-- ===================== 方向盘（视觉，插件要求 steering_wheel_joint） ===================== -->
    <link name="steering_wheel">
      <pose>0.36 -0.63 0.99 -1.3 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia><ixx>0.1458</ixx><iyy>0.1458</iyy><izz>0.125</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="c">
        <geometry><cylinder><radius>0.178</radius><length>0.04</length></cylinder></geometry>
      </collision>
      <visual name="v">
        <geometry><cylinder><radius>0.178</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
    <joint name="steering_joint" type="revolute">
      <parent>chassis</parent>
      <child>steering_wheel</child>
      <axis>
        <xyz>0 0.96 0.27</xyz>
        <limit><lower>-7.85</lower><upper>7.85</upper></limit>
        <dynamics><damping>1.0</damping></dynamics>
      </axis>
    </joint>

    <!-- ===================== 前左：转向 + 车轮 ===================== -->
    <link name="front_left_steering_link">
      <pose>0.76 -1.41 0.3 0 0 0</pose>
      <inertial>
        <mass>5</mass>
        <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
    </link>
    <joint name="front_left_steer_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_left_steering_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-0.6</lower><upper>0.6</upper></limit>
        <dynamics><damping>10.0</damping></dynamics>
      </axis>
    </joint>

    <link name="front_left_wheel_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>11</mass>
        <inertia><ixx>0.586</ixx><iyy>0.335</iyy><izz>0.335</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="c">
        <pose>0 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.31265</radius><length>0.2</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
          <contact><ode><min_depth>0.001</min_depth><kp>1e9</kp></ode></contact>
        </surface>
      </collision>
      <visual name="v">
        <pose>0 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.31265</radius><length>0.2</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_steering_link</parent>
      <child>front_left_wheel_link</child>
      <axis><xyz>1 0 0</xyz><dynamics><friction>0.5</friction></dynamics></axis>
    </joint>

    <!-- ===================== 前右：转向 + 车轮 ===================== -->
    <link name="front_right_steering_link">
      <pose>-0.76 -1.41 0.3 0 0 0</pose>
      <inertial>
        <mass>5</mass>
        <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
    </link>
    <joint name="front_right_steer_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_right_steering_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-0.6</lower><upper>0.6</upper></limit>
        <dynamics><damping>10.0</damping></dynamics>
      </axis>
    </joint>

    <link name="front_right_wheel_link">
      <inertial>
        <mass>11</mass>
        <inertia><ixx>0.586</ixx><iyy>0.335</iyy><izz>0.335</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="c">
        <pose>0 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.31265</radius><length>0.2</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
          <contact><ode><min_depth>0.001</min_depth><kp>1e9</kp></ode></contact>
        </surface>
      </collision>
      <visual name="v">
        <pose>0 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.31265</radius><length>0.2</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_steering_link</parent>
      <child>front_right_wheel_link</child>
      <axis><xyz>1 0 0</xyz><dynamics><friction>0.5</friction></dynamics></axis>
    </joint>

    <!-- ===================== 后轮（驱动轮） ===================== -->
    <link name="rear_left_wheel_link">
      <pose>0.786 1.45 0.3 0 0 0</pose>
      <inertial>
        <mass>11</mass>
        <inertia><ixx>0.586</ixx><iyy>0.335</iyy><izz>0.335</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="c">
        <pose>0 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.31265</radius><length>0.2</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.1</mu><mu2>1.1</mu2></ode></friction>
          <contact><ode><min_depth>0.001</min_depth><kp>1e9</kp></ode></contact>
        </surface>
      </collision>
      <visual name="v">
        <pose>0 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.31265</radius><length>0.2</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_left_wheel_link</child>
      <axis><xyz>1 0 0</xyz><dynamics><friction>0.5</friction></dynamics></axis>
    </joint>

    <link name="rear_right_wheel_link">
      <pose>-0.786 1.45 0.3 0 0 0</pose>
      <inertial>
        <mass>11</mass>
        <inertia><ixx>0.586</ixx><iyy>0.335</iyy><izz>0.335</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="c">
        <pose>0 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.31265</radius><length>0.2</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.1</mu><mu2>1.1</mu2></ode></friction>
          <contact><ode><min_depth>0.001</min_depth><kp>1e9</kp></ode></contact>
        </surface>
      </collision>
      <visual name="v">
        <pose>0 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.31265</radius><length>0.2</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_right_wheel_link</child>
      <axis><xyz>1 0 0</xyz><dynamics><friction>0.5</friction></dynamics></axis>
    </joint>

    <!-- ===================== 阿克曼驱动插件（ROS2） ===================== -->
    <plugin name="gazebo_ros_ackermann_drive" filename="libgazebo_ros_ackermann_drive.so">
      <ros>
        <!-- 最小骨架使用全局话题(/cmd_vel,/odom,/distance)，便于 Nav2 开箱即用；
             多机器人场景可加 <namespace>/prius</namespace> 并相应重映射。 -->
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
        <remapping>distance:=distance</remapping>
      </ros>
      <update_rate>100.0</update_rate>

      <!-- 驱动轮（后轮） -->
      <rear_left_joint>rear_left_wheel_joint</rear_left_joint>
      <rear_right_joint>rear_right_wheel_joint</rear_right_joint>
      <!-- 前轮（从动+转向） -->
      <front_left_joint>front_left_wheel_joint</front_left_joint>
      <front_right_joint>front_right_wheel_joint</front_right_joint>
      <!-- 转向关节 -->
      <left_steering_joint>front_left_steer_joint</left_steering_joint>
      <right_steering_joint>front_right_steer_joint</right_steering_joint>
      <steering_wheel_joint>steering_joint</steering_wheel_joint>

      <!-- 运动学限制 -->
      <max_steer>0.5</max_steer>            <!-- 轮胎最大转角(rad)；注：max_steer=0.6 时 Ackermann 内轮目标角
           atan2(tan0.6, 1-0.2657·tan0.6)≈0.697 会超过 joint 限位 0.6，大 ω 会把转向节压死在限位，
           车速趋零后轮胎 cone_model 剪切自锁（900 N·m 回正力也拉不回）→ 转向永久锁死 -->
      <max_steering_angle>7.85</max_steering_angle>
      <max_speed>20</max_speed>             <!-- 最大线速度(m/s) -->

      <!-- PID（需按车重/轮径微调）
           ⚠️ right 转向 joint 实测 SetForce 正力会使 Position 读数往负方向加速（力-读数物理镜像），
           正增益会让 right 在任何 ω≠0 时单调发散锁死 -0.6（left 正常）。
           故 right 的 P/D 取负号抵消镜像，恢复负反馈；直行（ω=0）时 PID 无力不受影响。 -->
      <left_steering_pid_gain>1500 0 1</left_steering_pid_gain>
      <left_steering_i_range>0 0</left_steering_i_range>
      <right_steering_pid_gain>-1500 0 -1</right_steering_pid_gain>
      <right_steering_i_range>0 0</right_steering_i_range>
      <linear_velocity_pid_gain>1000 0 1</linear_velocity_pid_gain>
      <linear_velocity_i_range>0 0</linear_velocity_i_range>

      <!-- 输出 -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <publish_distance>true</publish_distance>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>chassis</robot_base_frame>
    </plugin>

  </model>
</sdf>
