<?xml version="1.0"?>
<model>
  <name>V2X Stop Light (ROS-controllable)</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <author>
    <name>V2X Dev</name>
    <email>dev@example.com</email>
  </author>

  <description>
    可由 ROS 控制的交通信号灯：红/黄/绿三个灯球各配一盏 point light，
    通过 /gazebo/set_light_properties 服务设置 diffuse 颜色与 intensity 实现“视觉点亮”。
    灯名 red_light / yellow_light / green_light（在 include 中带模型名前缀）。
  </description>
</model>
