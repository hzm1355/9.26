<?xml version="1.0" ?>
<!-- ============================================================================
  v2x_city —— 由 scene_builder.py 从 v2x_scene.yaml 自动生成，勿手改。
  元素：道路拓扑(多车道) / 人行横道 / 高架 / 停车场出入口 / ETC 门架 / RSU /
        信号灯 / 绿化 / 学校与楼宇 / 激光锚点。设备坐标见 scene_devices.yaml
============================================================================ -->
<sdf version="1.6">
  <world name="v2x_city">

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.8 0.95 1</background>
      <shadows>1</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>300 300</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>300 300</size></plane></geometry>
          <material><ambient>0.35 0.55 0.3 1</ambient><diffuse>0.35 0.55 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 区域触发底座位姿源：发布 /model_states（全模型位姿+速度） -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so"/>


  <!-- road_NS-north -->
  <model name="road_NS-north">
    <static>true</static>
    <link name="link">
      <pose>0 18.2 0.02 0 0 1.5708</pose>
