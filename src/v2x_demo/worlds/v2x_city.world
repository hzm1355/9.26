  <!-- 场景相机 v2x_scene_cam（界面实景3D 视频源） -->
  <model name="v2x_scene_cam">
    <static>false</static>
    <pose>0 -40 30 0 0 0</pose>
    <link name="link">
      <kinematic>true</kinematic>
      <gravity>false</gravity>
      <inertial><mass>0.1</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
      <visual name="body">
        <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <sensor name="cam" type="camera">
        <always_on>1</always_on>
        <camera>
          <horizontal_fov>1.15</horizontal_fov>
          <image><width>960</width><height>600</height></image>
          <clip><near>0.1</near><far>500</far></clip>
        </camera>
        <update_rate>25</update_rate>
        <plugin name="cam_plugin" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/v2x_scene_cam</namespace>
          </ros>
        </plugin>
      </sensor>
    </link>
  </model>


  </world>
</sdf>
