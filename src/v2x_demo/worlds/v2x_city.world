  <!-- 信号灯 TL-J1-NE (组话题 traffic_light/J1_ns/state) -->
  <model name="TL-J1-NE">
    <static>true</static>
    <pose>6.5 6.5 0 0 0 -1.5708</pose>
    <link name="link">
      <visual name="pole">
        <pose>0 0 1.2 0 0 0</pose>
        <geometry><cylinder><radius>0.06</radius><length>2.4</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <collision name="pole_c">
        <pose>0 0 1.2 0 0 0</pose>
        <geometry><cylinder><radius>0.06</radius><length>2.4</length></cylinder></geometry>
      </collision>
      <visual name="housing">
        <pose>0 0 2.5 0 0 0</pose>
        <geometry><box><size>0.18 0.30 0.90</size></box></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
      <visual name="red">
        <pose>0.10 0 2.78 0 0 0</pose>
        <geometry><sphere><radius>0.09</radius></sphere></geometry>
        <material><ambient>0.45 0 0 1</ambient><diffuse>0.5 0 0 1</diffuse><emissive>0.9 0.05 0.05 1</emissive></material>
      </visual>
      <visual name="yellow">
        <pose>0.10 0 2.50 0 0 0</pose>
        <geometry><sphere><radius>0.09</radius></sphere></geometry>
        <material><ambient>0.45 0.36 0 1</ambient><diffuse>0.5 0.4 0 1</diffuse></material>
      </visual>
      <visual name="green">
        <pose>0.10 0 2.22 0 0 0</pose>
        <geometry><sphere><radius>0.09</radius></sphere></geometry>
        <material><ambient>0 0.45 0 1</ambient><diffuse>0 0.5 0 1</diffuse></material>
