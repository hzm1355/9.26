# 通行记录查询（协议 §三.(五).5）：按车牌/方向/闸机/结果/时段过滤，
# 数据源是 parking_recorder_node 常驻内存的环形记录（上限 max_records_in_memory）。
string plate_number         # 子串匹配即可（"88990" 能命中 "京B88990"）；空串=不过滤
string vehicle_id           # 空串=不过滤
string gate_id              # 空串=不过滤

uint8 DIR_ANY=0
uint8 DIR_IN=1              # 进场
uint8 DIR_OUT=2             # 出场
uint8 direction

uint8 RESULT_ANY=0
uint8 RESULT_ALLOWED=1
uint8 RESULT_DENIED=2
uint8 RESULT_PENDING=3
uint8 result

float64 t0                  # 仿真时间下界，<=0 表示不设
float64 t1                  # 上界，<=0 表示不设
int32 limit                 # 返回条数上限；<=0 表示全部
bool newest_first           # true=按时刻倒序（默认取最近的若干条）
---
bool success
string message
int32 matched               # 命中总条数（不受 limit 影响，用于对账）
int32 returned
ParkingPass[] passes        # 与 limit 一致，结构化返回
string[] lines              # 一行一条的人读表格行
int32 stored                # 内存中当前保留的记录总数
